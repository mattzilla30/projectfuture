<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground layer: the steering-wheel/sunset mark, no
     background fill of its own (see ic_launcher_background.xml). Geometry
     (ring at radius 34/29.5, bar at y=61.5, sun radius 13.5, legs) was
     measured directly off the source logo image, then wrapped in a 0.95
     scale around the icon center so the outer ring stays inside the
     adaptive-icon safe zone (a ~66dp circle inscribed in this 108dp
     viewport) instead of risking a clip on aggressive launcher masks. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.95"
        android:scaleY="0.95">
        <!-- Wheel ring: outer circle (sweep=1) minus inner circle (sweep=0) via nonzero fill. -->
        <path
            android:fillColor="#F6F4EE"
            android:pathData="M54,20A34,34 0,1 1,53.99 20zM54,24.5A29.5,29.5 0,1 0,54.01 24.5z" />
        <!-- Sunset/sunrise disc, its flat edge sitting on the horizon bar below. -->
        <path
            android:fillColor="#F2A33A"
            android:pathData="M40.5,59.35A13.5,13.5 0,0 1,67.5 59.35z" />
        <!-- Horizon bar (edge-to-edge chord of the ring) and the two diverging spokes below it. -->
        <path
            android:strokeColor="#F6F4EE"
            android:strokeWidth="4.5"
            android:strokeLineCap="butt"
            android:pathData="M20.84,61.5h66.32M50.3,61.5L44.8,81.7M57.7,61.5L63.2,81.7" />
    </group>
</vector>
